<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings: xem Directory.Build.props -->
  <!-- Version của package: xem Directory.Packages.props -->

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Startup project của dotnet ef/PMC phải reference Design; PrivateAssets để khỏi rò ra ngoài -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YTTrending.Application\YTTrending.Application.csproj" />
    <ProjectReference Include="..\YTTrending.Infrastructure\YTTrending.Infrastructure.csproj" />
  </ItemGroup>

</Project>
